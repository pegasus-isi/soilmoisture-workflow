# Soil-moisture workflow container (irrigation decision support, Open-Meteo API).
#
# Converted from Docker/SoilMoisture_Dockerfile. `Bootstrap: docker` pulls and
# converts the OCI base image directly, so no Docker installation is needed to
# build the .sif.
#
# Build (on an x86_64 Linux host — see README):
#   apptainer build Apptainer/SoilMoisture_Container.sif Apptainer/SoilMoisture_Container.def

Bootstrap: docker
From: python:3.8.12-slim

%post
    # Debian 11 (bullseye) is archived: deb.debian.org no longer serves it, and
    # bullseye-security does not exist on archive.debian.org at all. Left alone,
    # `apt-get update` fails, curl/wget are never installed, and the build still
    # reports success -- producing an image in which no Pegasus job can start,
    # because PegasusLite fetches its worker package with curl before the job
    # script runs.
    sed -i \
        -e "s|http://deb.debian.org/debian|http://archive.debian.org/debian|g" \
        -e "/security.debian.org/d" \
        -e "/bullseye-updates/d" \
        /etc/apt/sources.list
    echo "Acquire::Check-Valid-Until \"false\";" > /etc/apt/apt.conf.d/99no-check-valid-until

    # Install system dependencies.
    # curl + wget are mandatory: PegasusLite downloads its worker package
    # inside the container before the job script ever runs.
    apt-get update && \
        apt-get install -y --no-install-recommends \
            git \
            wget \
            curl \
            build-essential \
            ca-certificates
    rm -rf /var/lib/apt/lists/*

    # Install Python dependencies
    pip install --no-cache-dir \
        pandas \
        numpy \
        matplotlib \
        scipy \
        requests \
        scikit-learn \
        pytz \
        torch \
        tqdm

    # Docker's WORKDIR /app has no Apptainer equivalent; create the directory
    # here and let Pegasus jobs cd into their own working directory at runtime.
    mkdir -p /app/output

%environment
    # Set Python to not buffer output (important for Pegasus log capture)
    export PYTHONUNBUFFERED=1

%runscript
    exec /bin/bash "$@"

%labels
    maintainer Komal Thareja <kthare10@renci.org>
    description Soil Moisture workflow - Open-Meteo irrigation decision support
